# Vorlage für .env (wird nicht eingecheckt). Werte aus dem Supabase-Dashboard
# eintragen: Project Settings → API. Ohne diese Datei läuft die App vollständig
# lokal, nur der Hundeapp-Sync ist dann ausgeblendet.
VITE_SUPABASE_URL=https://<projekt>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_CLOUD_SYNC=1
