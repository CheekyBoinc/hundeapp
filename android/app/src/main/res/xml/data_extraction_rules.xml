<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Sync-Zugangsdaten (GitHub-Token) weder in Cloud-Backups
     noch bei der Geräteübertragung mitnehmen. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    </device-transfer>
</data-extraction-rules>
